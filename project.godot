; Engine configuration file.
; Akademi — Yandere-style UI & environment demo.

config_version=5

[application]

config/name="Akademi UI Demo"
config/description="Single-player walkable school environment + anime UI demo."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

State="*res://scripts/state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.03, 0.07, 1)
